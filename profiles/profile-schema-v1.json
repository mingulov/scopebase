{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScopeBase catalog metadata schema version 1",
  "$comment": "Graph/reference/version-pair/byte limits and semantic baseline checks are enforced by the local admission implementations, not remote schema resolution. This is no qualification record.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_revision": {
      "$ref": "#/$defs/positiveU32"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 128
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 512
    },
    "families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 128
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 256
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 4096
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 128
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "catalog_revision",
    "tasks",
    "obligations",
    "families",
    "cells",
    "cases",
    "profiles",
    "extensions"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*-v[1-9][0-9]*$",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "positiveU32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "obligationRef": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "research_todo",
            "regression_family",
            "public_contract_gap",
            "user_conformance",
            "overlap_row"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "research_todo",
            "regression_family",
            "public_contract_gap",
            "user_conformance",
            "overlap_row"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "maxLength": 65536
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "kind",
        "id",
        "description",
        "owners"
      ],
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "short_contract": {
          "type": "string",
          "maxLength": 65536,
          "minLength": 1
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligationRef"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 8192
        }
      },
      "required": [
        "id",
        "short_contract",
        "obligations"
      ],
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4",
            "T5"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 65536,
          "minLength": 1
        },
        "binding": {
          "const": "LOGICAL_ONLY"
        }
      },
      "required": [
        "id",
        "tier",
        "description",
        "binding"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/positiveU32"
        },
        "path": {
          "type": "string",
          "maxLength": 65536,
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "(^/|\\\\|\u0000)"
              },
              {
                "pattern": "(^|/)(\\.|\\.\\.|)(/|$)"
              }
            ]
          }
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "entrypoint": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "revision",
        "path",
        "sha256",
        "entrypoint"
      ],
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "properties": {
        "executable": {
          "$ref": "#/$defs/artifact"
        },
        "fixture": {
          "$ref": "#/$defs/artifact"
        },
        "oracle": {
          "$ref": "#/$defs/artifact"
        },
        "bad_control": {
          "$ref": "#/$defs/artifact"
        },
        "oracle_basis": {
          "type": "string",
          "maxLength": 65536,
          "minLength": 1
        },
        "control_assertion": {
          "type": "string",
          "maxLength": 65536,
          "minLength": 1
        }
      },
      "required": [
        "executable",
        "fixture",
        "oracle",
        "bad_control",
        "oracle_basis",
        "control_assertion"
      ],
      "additionalProperties": false
    },
    "requiredCase": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "case_version": {
          "$ref": "#/$defs/positiveU32"
        },
        "when_extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileId"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "case_id",
        "case_version",
        "when_extensions"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "family": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/positiveU32"
        },
        "implementation_status": {
          "enum": [
            "UNIMPLEMENTED",
            "REGISTERED_EXECUTABLE"
          ]
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 128
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligationRef"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 8192
        },
        "required_cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 256
        },
        "registration": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/registration"
            }
          ]
        }
      },
      "required": [
        "id",
        "family",
        "version",
        "implementation_status",
        "owners",
        "obligations",
        "required_cells",
        "registration"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "implementation_status": {
                "const": "UNIMPLEMENTED"
              }
            }
          },
          "then": {
            "properties": {
              "registration": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "registration": {
                "$ref": "#/$defs/registration"
              }
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/profileId"
        },
        "definition_state": {
          "enum": [
            "DRAFT",
            "FROZEN"
          ]
        },
        "requires_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileId"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 128
        },
        "requires_extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileId"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 128
        },
        "required_cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requiredCase"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 8192
        },
        "open_owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "definition_state",
        "requires_profiles",
        "requires_extensions",
        "required_cases",
        "open_owners"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "definition_state": {
                "const": "DRAFT"
              }
            }
          },
          "then": {
            "properties": {
              "open_owners": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "open_owners": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/profileId"
        },
        "profile": {
          "$ref": "#/$defs/profileId"
        },
        "requires_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileId"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 128
        },
        "requires_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 128
        },
        "required_cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requiredCase"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 8192
        }
      },
      "required": [
        "id",
        "profile",
        "requires_profiles",
        "requires_tasks",
        "required_cases"
      ],
      "additionalProperties": false
    }
  }
}
