{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopebase.local/schemas/tc01/bpf-compat-profiles.schema.json",
  "title": "TC01 compiler-profile, patch-register and toolchain-inventory documents",
  "description": "Shape contract for schema_version 1 documents. Strict admission (duplicate-field rejection at every level, cross-field CPU/feature coherence, exact preimage/hash grammar) is enforced by scopebase_testkit::object parsers, not by this schema alone. Unknown fields refuse: new fields require a new schema_version.",
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "profile": {
      "type": "object",
      "required": ["schema_version", "artifact", "profile", "target", "backend", "cpu", "features_enabled", "features_disabled", "required_cells", "optional_cells"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "artifact": {"$ref": "#/$defs/label"},
        "profile": {"$ref": "#/$defs/profileId"},
        "target": {
          "type": "object",
          "required": ["triple", "arch", "endian", "pointer_width_bits"],
          "additionalProperties": false,
          "properties": {
            "triple": {"type": "string", "minLength": 1, "maxLength": 128},
            "arch": {"enum": ["bpf", "bpfel", "bpfeb"]},
            "endian": {"enum": ["little", "big"]},
            "pointer_width_bits": {"enum": [32, 64]}
          }
        },
        "backend": {
          "type": "object",
          "required": ["kind", "name", "version", "sha256"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["llvm-llc", "clang", "rustc", "bpf-linker", "aya", "libbpf"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "cpu": {"enum": ["generic", "v3", "v4", null]},
        "features_enabled": {
          "type": "array",
          "items": {"enum": ["alu32", "jump32", "ext-jumps", "signed-load-move", "byte-swap", "signed-div", "long-jump", "imm-store", "acqrel", "indirect-jumps"]}
        },
        "features_disabled": {
          "type": "array",
          "items": {"enum": ["alu32", "jump32", "ext-jumps", "signed-load-move", "byte-swap", "signed-div", "long-jump", "imm-store", "acqrel", "indirect-jumps"]}
        },
        "required_cells": {"type": "array", "items": {"$ref": "#/$defs/label"}},
        "optional_cells": {"type": "array", "items": {"$ref": "#/$defs/label"}}
      },
      "description": "Cross-field rules enforced by ObjectContract::from_json: no feature both enabled and disabled; generic/null CPU admits no enabled features; v3 refuses v4-only features (acqrel, indirect-jumps). Cell ids admit no wildcards."
    },
    "patchRegister": {
      "type": "object",
      "required": ["schema_version", "kind", "patches"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "tc01_patch_register"},
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "scope", "upstream_base", "preimage_kind", "preimage", "preimage_note", "patch_sha256", "applicability", "affected_profiles", "owner", "defect_test", "upstream_status", "inclusion_test", "removal_test", "expired"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/label"},
              "scope": {"$ref": "#/$defs/label"},
              "upstream_base": {"type": "string", "minLength": 1},
              "preimage_kind": {"enum": ["sha256", "git-sha1"]},
              "preimage": {"type": "string", "minLength": 1},
              "preimage_note": {"type": "string", "minLength": 1, "maxLength": 1024},
              "patch_sha256": {"$ref": "#/$defs/sha256"},
              "applicability": {"type": "string", "minLength": 1},
              "affected_profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profileId"}},
              "owner": {"type": "string", "minLength": 1},
              "defect_test": {"type": "string", "minLength": 1},
              "upstream_status": {
                "type": "object",
                "required": ["state", "ref"],
                "additionalProperties": false,
                "properties": {
                  "state": {"enum": ["open", "merged", "unsubmitted", "not-applicable"]},
                  "ref": {"type": "string", "minLength": 1}
                }
              },
              "inclusion_test": {"type": "string", "minLength": 1},
              "removal_test": {"type": "string", "minLength": 1},
              "expired": {"type": "boolean"}
            }
          },
          "description": "Preimage length is kind-checked by PatchRegister::from_json (64 hex for sha256, 40 for git-sha1). Record ids are unique."
        }
      }
    },
    "toolchainInventory": {
      "type": "object",
      "required": ["schema_version", "kind", "tools"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "tc01_toolchain_inventory"},
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role", "name", "version", "version_detail", "sha256", "hash_status", "origin", "origin_ref", "used_for"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/label"},
              "role": {"enum": ["frontend", "backend", "linker", "rust", "runner", "source-archive"]},
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "version_detail": {"type": "string", "minLength": 1},
              "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "hash_status": {"enum": ["recorded", "unrecorded"]},
              "origin": {"enum": ["pinned-archive", "preserved-binary", "system-observed"]},
              "origin_ref": {"type": "string", "minLength": 1},
              "used_for": {"type": "string", "minLength": 1}
            }
          },
          "description": "ToolchainInventory::from_json requires recorded hashes to be present and unrecorded entries to carry null with an explicit origin_ref. Tool ids are unique."
        }
      }
    }
  },
  "anyOf": [
    {"$ref": "#/$defs/profile"},
    {"$ref": "#/$defs/patchRegister"},
    {"$ref": "#/$defs/toolchainInventory"}
  ]
}
